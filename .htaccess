# Hostinger / Motricialy Stage A9 isolation gate.
# This directory is a closed test fixture, not an application or public landing page.
Options -Indexes
Require all denied
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, max-age=0"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Temporary A9.8: only this authenticated, paid-disabled QA bridge is reachable.
# The PHP entrypoint additionally requires a 256-bit Hostinger-private header.
<Files "a9_8_gateway.php">
  Require all granted
</Files>
